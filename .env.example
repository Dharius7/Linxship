# Canonical public URL. Set the deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default display currency used when a record has no explicit currency.
NEXT_PUBLIC_APP_CURRENCY=USD

# Supabase project settings (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Never prefix this value with NEXT_PUBLIC_ or expose it to a browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Legacy Supabase projects may use these names instead of the two keys above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_me
